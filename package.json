{
  "name": "bull-board-hono",
  "version": "2.0.0",
  "description": "Lightweight Bull Board dashboard served via Hono.js with multi-Redis support, basic auth, and auto-discovery of queues",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "prepare": "husky",
    "release": "commit-and-tag-version",
    "release:first": "commit-and-tag-version --first-release",
    "release:dry": "commit-and-tag-version --dry-run",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@bull-board/api": "^9.11.0",
    "@bull-board/hono": "^9.11.0",
    "@hono/node-server": "^2.1.6",
    "bullmq": "^5.81.5",
    "hono": "^4.13.16",
    "ioredis": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.6",
    "commit-and-tag-version": "^13.3.0",
    "husky": "^9.1.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
